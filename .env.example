# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_MASTER_PIN: Master Passcode for Private Terminal Access (Default: 1234)
VITE_MASTER_PIN="1234"

# VITE_SOLANA_RPC_URL / NEXT_PUBLIC_SOLANA_RPC_URL: Custom low-latency Solana Mainnet RPC endpoint (e.g. Helius, QuickNode, Alchemy, or Ankr)
# Used to bypass public clusterApiUrl rate limits (HTTP 429) on Vercel / Production
VITE_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# VITE_TARGET_WALLET / NEXT_PUBLIC_TARGET_WALLET: Static target Solana public key to permanently bind terminal
# If specified, terminal will persist and monitor this wallet address without requiring repeated re-connection
VITE_TARGET_WALLET=""
NEXT_PUBLIC_TARGET_WALLET=""

